DATABASE_URL=
DB_HOST=localhost
DB_NAME=cen_payroll_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5

JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TEMPORARY_PASSWORD_LENGTH=12
ALLOWED_ORIGINS=http://localhost:5173

# Limite por direccion de las rutas publicas de /auth, por ventana.
AUTH_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=60
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_VERIFY_RATE_LIMIT=10
# Detras de un proxy (Render, nginx), las IP en las que uvicorn confia para
# leer X-Forwarded-For. Sin esto todas las solicitudes parecen venir del proxy.
# FORWARDED_ALLOW_IPS=*

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cen.com
ADMIN_PASSWORD=admin1234
ADMIN_BASE_SALARY=20000

# El superadmin solo se crea si defines correo y contrasena (minimo 12
# caracteres). Pedira cambiarla en su primer acceso.
SUPERADMIN_NAME=Superadministrador
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Opcional, para desarrollo: un dueño que queda como dueño de la primera
# empresa. Mismas reglas que el superadmin (minimo 12 caracteres, cambio de
# contrasena en el primer acceso).
OWNER_NAME=Dueño de prueba
OWNER_EMAIL=
OWNER_PASSWORD=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cenpayroll.com
SMTP_USE_TLS=True
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5
